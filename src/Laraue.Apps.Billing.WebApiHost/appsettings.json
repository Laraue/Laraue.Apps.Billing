{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Payments": {
    "DefaultProvider": "robokassa",
    "Robokassa": {
      "PaymentUrl": "https://auth.robokassa.ru/Merchant/Index.aspx",
      "Culture": "ru",
      "Currencies": [ "RUB" ],
      "HashAlgorithm": "Md5",
      "IsTest": true
    },
    "Redirects": {
      "SuccessUrl": "http://localhost:3000/payment/success",
      "FailUrl": "http://localhost:3000/payment/fail",
      "Services": {
        "LaraueBoards": {
          "SuccessUrl": "http://localhost:3000/payment/success",
          "FailUrl": "http://localhost:3000/payment/fail"
        }
      }
    }
  },
  "ConnectionStrings": {
    "Postgre": "User ID=postgres;Password=postgres;Host=localhost;Port=5432;Database=billing;Command Timeout=0"
  }
}
